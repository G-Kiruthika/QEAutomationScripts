{
  "pages": [
    {
      "class_name": "LoginPage",
      "file_name": "login_page.py",
      "description": "Represents the e-commerce website login page.",
      "elements": [
        {
          "name": "email_field",
          "type": "input",
          "locator": "//input[@type='email']",
          "locator_strategy": "xpath",
          "placeholder": true,
          "description": "Email input field."
        },
        {
          "name": "password_field",
          "type": "input",
          "locator": "//input[@type='password']",
          "locator_strategy": "xpath",
          "placeholder": true,
          "description": "Password input field."
        },
        {
          "name": "login_button",
          "type": "button",
          "locator": "//button[contains(text(),'Login')]",
          "locator_strategy": "xpath",
          "placeholder": true,
          "description": "Login button."
        },
        {
          "name": "error_message",
          "type": "label",
          "locator": "//div[contains(@class,'error-message')]",
          "locator_strategy": "xpath",
          "placeholder": true,
          "description": "Error message label displayed on failed login."
        }
      ],
      "actions": [
        {
          "name": "navigate_to_login",
          "description": "Navigates to the login page.",
          "parameters": ["url"],
          "returns": "None"
        },
        {
          "name": "enter_email",
          "description": "Enters email into the email field.",
          "parameters": ["email"],
          "returns": "None"
        },
        {
          "name": "enter_password",
          "description": "Enters password into the password field.",
          "parameters": ["password"],
          "returns": "None"
        },
        {
          "name": "click_login",
          "description": "Clicks the login button.",
          "parameters": [],
          "returns": "None"
        },
        {
          "name": "get_error_message",
          "description": "Returns the login error message if present.",
          "parameters": [],
          "returns": "str"
        }
      ]
    },
    {
      "class_name": "DashboardPage",
      "file_name": "dashboard_page.py",
      "description": "Represents the user dashboard/home page after successful login.",
      "elements": [
        {
          "name": "user_name_label",
          "type": "label",
          "locator": "//span[contains(@class,'user-name')]",
          "locator_strategy": "xpath",
          "placeholder": true,
          "description": "Displays the logged-in user's name."
        }
      ],
      "actions": [
        {
          "name": "is_user_logged_in",
          "description": "Checks if the user is logged in by verifying user name label is displayed.",
          "parameters": [],
          "returns": "bool"
        }
      ]
    }
  ]
}